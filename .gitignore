# Code generated by project-standards. DO NOT EDIT.
#
# The universal .gitignore every project shares, whatever its languages. Add a
# project's own entries under ignore.git in mklv.config.json; the conformance
# bot appends them below and rewrites this file every week.

# OS files
.DS_Store
Thumbs.db
ehthumbs.db

# Editors. Shared VS Code settings stay committable.
.idea/
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Environment files and unencrypted secrets. Encrypted *.sops.json files are
# safe to commit.
.env
.env.*
!.env.example
.envrc
*.local
secrets/*
!secrets/*.sops.json
!secrets/*.sops.json.example
!secrets/README.md

# Dependencies and caches
node_modules/
.deno/
.npm/
vendor/
.cache/
.vite/
*.tsbuildinfo

# Build output
dist/
dist-ssr/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Tests and coverage
coverage/
*.lcov
.nyc_output/
*.test
*.out
*.coverprofile
profile.cov
.goldmark-lint-cache

# Go workspaces
go.work
go.work.sum

# OpenTofu and Terraform
.terraform/
.opentofu/
.terragrunt-cache/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Logs and scratch files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
*.tmp
*.temp
